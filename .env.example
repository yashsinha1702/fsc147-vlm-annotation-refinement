# Copy to .env (git-ignored), fill in, then:  set -a; source .env; set +a
# Never put the key file itself inside this repository.

GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/service-account-key.json

